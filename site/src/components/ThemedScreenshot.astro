---
import type { Locale } from '../consts';
import { assetUrl } from '../i18n/utils';

interface Props {
  
  name: string;
  
  locale: Locale;
  alt: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'auto' | 'sync';
  imgClass?: string;
  /** Pin to the dark shot instead of following the theme. For surfaces that sit
   *  on light card chrome next to dark artwork, where swapping to the light
   *  screenshot makes that one tile read as a hole in the grid. */
  forceDark?: boolean;
}

const {
  name,
  locale,
  alt,
  loading = 'lazy',
  decoding = 'async',
  imgClass = 'w-full h-full object-cover',
  forceDark = false,
} = Astro.props;

const base = assetUrl(`images/screenshots/${name}-${locale}`);
const darkSrc = `${base}-dark.png`;
const lightSrc = `${base}-light.png`;
---

{forceDark ? (
  <span class="block w-full h-full">
    <img src={darkSrc} alt={alt} loading={loading} decoding={decoding} class={imgClass} />
  </span>
) : (
  <span class="themed-screenshot block w-full h-full">
    <img
      src={darkSrc}
      alt={alt}
      loading={loading}
      decoding={decoding}
      class:list={[imgClass, 'themed-screenshot__img themed-screenshot__img--dark']}
    />
    <img
      src={lightSrc}
      alt={alt}
      loading={loading}
      decoding={decoding}
      class:list={[imgClass, 'themed-screenshot__img themed-screenshot__img--light']}
    />
  </span>
)}
