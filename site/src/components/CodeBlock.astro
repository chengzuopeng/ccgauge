---
/**
 * Lightweight code-block component with a copy-to-clipboard button.
 *
 * Astro auto-applies syntax highlighting to fenced blocks inside .md/.mdx,
 * but inline `<pre><code>` doesn't get the treatment for free. To keep
 * things simple we render plain monospace text with brand styling — good
 * enough for the short install snippets / config blocks the marketing
 * site needs.
 *
 * Labels (`copyLabel`, `copiedLabel`, `failedLabel`) auto-localize via
 * `useTranslations(Astro.currentLocale)` — callers don't need to thread
 * Chinese strings through every usage. Pass explicit overrides only when
 * a specific block needs a different label (rare).
 */

import { useTranslations } from '../i18n/utils';
import { DEFAULT_LOCALE, type Locale } from '../consts';

interface Props {
  code: string;
  /** Language label shown top-right; purely decorative. */
  lang?: string;
  /** Optional override for the copy button text + aria-label. */
  copyLabel?: string;
  /** Optional override for the text shown after a successful copy. */
  copiedLabel?: string;
  /** Optional override for the text shown after the copy fails. */
  failedLabel?: string;
}

// `Astro.currentLocale` is computed from the URL routing config — for
// pages under `/zh/...` it's `'zh'`, otherwise `'en'` (the default).
// Cast through `Locale` so the `useTranslations` call type-checks.
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useTranslations(locale);

const {
  code,
  lang,
  copyLabel = t('common.copy'),
  copiedLabel = t('common.copied'),
  failedLabel = t('common.copyFailed'),
} = Astro.props;
---

<div
  class="code-shell group relative rounded-card border border-border overflow-hidden"
  data-codeblock
>
  {lang && (
    <span
      class="absolute top-2.5 left-3 text-[10px] uppercase tracking-[0.08em] font-semibold text-text-tertiary"
    >
      {lang}
    </span>
  )}
  <button
    type="button"
    data-copy-btn
    data-copy-payload={code}
    data-copy-label={copyLabel}
    data-copied-label={copiedLabel}
    data-failed-label={failedLabel}
    class="absolute top-2 right-2 inline-flex items-center gap-1 px-2 py-1 rounded-button text-[11px] font-medium text-text-tertiary hover:text-text-primary hover:bg-bg-surface-hi border border-transparent hover:border-border transition-colors"
    aria-label={copyLabel}
  >
    <svg class="copy-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <svg class="copy-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5" />
    </svg>
    <span data-copy-text>{copyLabel}</span>
  </button>
  <pre class:list={['p-4 pt-9 text-sm leading-relaxed font-mono overflow-x-auto', lang && 'pt-9']}><code>{code}</code></pre>
</div>

<script>
  // Color classes we toggle on the button to signal copy state. Kept
  // outside the listener so the constants don't get reallocated per click.
  const SUCCESS_CLASS = 'text-brand';
  const FAILURE_CLASS = 'text-danger';
  const STATE_RESET_MS = 1500;

  document.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const payload = btn.dataset.copyPayload ?? '';
      const label = btn.dataset.copyLabel ?? 'Copy';
      const copied = btn.dataset.copiedLabel ?? 'Copied!';
      const failed = btn.dataset.failedLabel ?? 'Copy failed';
      const textEl = btn.querySelector('[data-copy-text]');

      const flash = (text: string, klass: string, copiedState: boolean) => {
        if (textEl) textEl.textContent = text;
        btn.classList.remove(SUCCESS_CLASS, FAILURE_CLASS);
        btn.classList.add(klass);
        // The checkmark only makes sense on success.
        btn.classList.toggle('is-copied', copiedState);
        window.setTimeout(() => {
          if (textEl) textEl.textContent = label;
          btn.classList.remove(klass, 'is-copied');
        }, STATE_RESET_MS);
      };

      // `navigator.clipboard` is undefined on insecure (non-https,
      // non-localhost) origins; `writeText` itself can also reject when
      // the user denies clipboard permission. Cover both by gating on
      // the API's existence and try/catching the call.
      if (!navigator.clipboard?.writeText) {
        flash(failed, FAILURE_CLASS, false);
        return;
      }
      try {
        await navigator.clipboard.writeText(payload);
        flash(copied, SUCCESS_CLASS, true);
      } catch {
        flash(failed, FAILURE_CLASS, false);
      }
    });
  });
</script>
