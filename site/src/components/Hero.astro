---
import type { Locale } from '../consts';
import ThemedScreenshot from './ThemedScreenshot.astro';
import { assetUrl } from '../i18n/utils';

interface Props {
  eyebrow?: string;
  title: string;
  
  titleAccent?: string;
  lede: string;
  
  imageSrc?: string;
  imageAlt?: string;
  
  screenshotName?: string;
  screenshotLocale?: Locale;
}

const { eyebrow, title, titleAccent, lede, imageSrc, imageAlt, screenshotName, screenshotLocale } = Astro.props;
const hasMedia = Boolean(screenshotName || imageSrc);
---

<section class="relative overflow-hidden">
  
  <div class="pointer-events-none absolute inset-x-0 top-[-120px] h-[400px] hero-glow" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-12 sm:pt-20 pb-12 sm:pb-16">
    <div class:list={['grid items-center gap-10 lg:gap-12', hasMedia ? 'lg:grid-cols-2' : '']}>
      <div class:list={['min-w-0', !hasMedia && 'max-w-3xl mx-auto text-center']}>
        {eyebrow && (
          <div class="pill-brand mb-5" data-animate style="--delay:0s">{eyebrow}</div>
        )}
        <h1 class="heading-hero" data-animate style="--delay:0.08s">
          {titleAccent ? (
            <>
              {title}{' '}
              <span class="text-brand">{titleAccent}</span>
            </>
          ) : (
            title
          )}
        </h1>
        <p class="lede mt-5 sm:mt-6 max-w-2xl" data-animate style="--delay:0.16s">
          {lede}
        </p>
        <div
          class:list={['mt-7 sm:mt-8 flex flex-wrap gap-3', !hasMedia && 'justify-center']}
          data-animate
          style="--delay:0.24s"
        >
          <slot name="cta" />
        </div>
        <div data-animate style="--delay:0.32s">
          <slot name="below-cta" />
        </div>
      </div>

      {hasMedia && (
        <div class="relative" data-animate style="--delay:0.2s">
          <div class="hero-frame aspect-[16/10]">
            {screenshotName && screenshotLocale ? (
              <ThemedScreenshot
                name={screenshotName}
                locale={screenshotLocale}
                alt={imageAlt ?? ''}
                loading="eager"
              />
            ) : (
              <img
                src={assetUrl(`images/${imageSrc}`)}
                alt={imageAlt ?? ''}
                loading="eager"
                decoding="async"
                class="w-full h-full object-cover"
              />
            )}
          </div>
          
          <div
            class="pointer-events-none absolute -bottom-3 -right-3 h-16 w-16 rounded-card border border-border-hi bg-bg-surface-hi flex items-center justify-center"
            aria-hidden="true"
          >
            <span class="text-brand text-xl">▸</span>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
